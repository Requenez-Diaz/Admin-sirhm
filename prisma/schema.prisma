generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  username           String              @unique
  lastName           String
  numberPhone        Int
  password           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  roleName           String
  image              String?
  PasswordResetToken PasswordResetToken?
  Reservation        Reservation[]
  role               Role                @relation(fields: [roleName], references: [roleName])
  UserImage          UserImage?
  Testimonial        Testimonial[]
}

model Role {
  id       Int    @id @default(autoincrement())
  descript String
  roleName String @unique
  users    User[]
}

model Reservation {
  id                 Int                  @id @default(autoincrement())
  createdAt          DateTime             @default(now())
  isRead             Boolean              @default(false)
  user_id            Int
  status             BookingsStatus       @default(PENDING)
  User               User                 @relation(fields: [user_id], references: [id])
  ReservationDetails ReservationDetails[]
}

model Testimonial {
  id         Int      @id @default(autoincrement())
  name       String
  avatar     String
  comment    String
  location   String
  rating     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  bedroomId  Int?
  userId     Int?
  isApproved Boolean  @default(false)
  Bedrooms   Bedroom? @relation(fields: [bedroomId], references: [id])
  User       User?    @relation(fields: [userId], references: [id])
}

model Season {
  id         Int          @id @default(autoincrement())
  dateStart  DateTime
  dateEnd    DateTime
  nameSeason SeasonType   @default(BAJA)
  Bedrooms   Bedroom[]
  Promotions Promotions[]
}

model Invoice {
  id           Int            @id @default(autoincrement())
  clientId     Int
  date         DateTime
  invoceDetail InvoceDetail[]
}

model InvoceDetail {
  id       Int     @id @default(autoincrement())
  invoceId Int
  item     String
  price    Int
  amount   Int
  Invoice  Invoice @relation(fields: [invoceId], references: [id])
}

model Bedroom {
  id                 Int                  @id @default(autoincrement())
  description        String
  lowSeasonPrice     Int
  highSeasonPrice    Int
  status             Boolean
  numberBedroom      Int
  seasonsId          Int?
  amenities          String[]
  capacity           Int
  createdAt          DateTime             @default(now())
  image              String
  updatedAt          DateTime             @updatedAt
  slug               String               @unique
  typeBedroomId      Int?
  galleryImages      BedroomImages[]
  Season             Season?              @relation(fields: [seasonsId], references: [id])
  TypeBedrooms       TypeBedrooms?        @relation(fields: [typeBedroomId], references: [id])
  BedroomsPromotions BedroomsPromotion[]
  ReservationDetails ReservationDetails[]
  Testimonial        Testimonial[]
}

model BedroomImages {
  id           Int      @id @default(autoincrement())
  bedroomId    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  fileName     String
  mimeType     String
  imageContent String?
  bedroom      Bedroom  @relation(fields: [bedroomId], references: [id])
}

model TypeBedrooms {
  id          Int       @id @default(autoincrement())
  nameType    String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Bedrooms    Bedroom[]
}

model UserImage {
  id     Int    @id @default(autoincrement())
  userId Int    @unique
  image  String
  User   User   @relation(fields: [userId], references: [id])
}

model Promotions {
  id                 Int                  @id @default(autoincrement())
  codePromotions     String
  porcentageDescuent Int
  dateStart          DateTime
  dateEnd            DateTime
  description        String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  seasonId           Int
  BedroomsPromotions BedroomsPromotion[]
  seasons            Season               @relation(fields: [seasonId], references: [id])
  ReservationDetails ReservationDetails[]
}

model BedroomsPromotion {
  id          Int        @id @default(autoincrement())
  bedroomId   Int
  promotionId Int
  bedroom     Bedroom    @relation(fields: [bedroomId], references: [id])
  promotion   Promotions @relation(fields: [promotionId], references: [id])

  @@unique([bedroomId, promotionId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model ReservationDetails {
  id             Int         @id @default(autoincrement())
  reservation_id Int
  price          Int
  dateStart      DateTime
  dateEnd        DateTime
  promotion_id   Int?
  status         Status
  created_at     DateTime    @default(now())
  bedrooms_id    Int
  guestQuantity  Int
  Bedrooms       Bedroom     @relation(fields: [bedrooms_id], references: [id])
  Promotions     Promotions? @relation(fields: [promotion_id], references: [id])
  Reservation    Reservation @relation(fields: [reservation_id], references: [id])
}

enum BookingsStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum Status {
  PENDING
  CONFIRMED
  CANCELLED
}

enum SeasonType {
  ALTA
  BAJA
}
