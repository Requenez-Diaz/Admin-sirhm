generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  username           String              @unique
  password           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  roleName           String
  image              String?
  Comments           Comments[]
  notifications      Notification[]
  PasswordResetToken PasswordResetToken?
  Reservation        Reservation[]
  role               Role                @relation(fields: [roleName], references: [roleName])
  UserImage          UserImage?
  testimonials       testimonials[]
}

model Role {
  id       Int    @id @default(autoincrement())
  descript String
  roleName String @unique
  users    User[]
}

model Reservation {
  id                 Int                  @id @default(autoincrement())
  createdAt          DateTime             @default(now())
  isRead             Boolean              @default(false)
  user_id            Int
  status             BookingsStatus       @default(PENDING)
  notifications      Notification[]
  User               User                 @relation(fields: [user_id], references: [id])
  ReservationDetails ReservationDetails[]
}

model Notification {
  id            Int              @id @default(autoincrement())
  title         String
  message       String
  email         String
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  userId        Int
  reservationId Int?
  type          NotificationType
  userImage     String?
  reservation   Reservation?     @relation(fields: [reservationId], references: [id])
  user          User             @relation(fields: [userId], references: [id])
}

model testimonials {
  id         Int       @id @default(autoincrement())
  name       String
  avatar     String
  comment    String
  location   String
  rating     Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  bedroomId  Int?
  userId     Int?
  isApproved Boolean   @default(false)
  Bedrooms   Bedrooms? @relation(fields: [bedroomId], references: [id])
  User       User?     @relation(fields: [userId], references: [id])
}

model historicReservations {
  id          Int         @id @default(autoincrement())
  bookingId   Int
  events      EventStatus
  description String
  date        DateTime
}

model Services {
  id          String             @id @default(uuid())
  nameService String
  description String
  price       Int
  bookings    bookingsServices[]
}

model Seasons {
  id         Int          @id @default(autoincrement())
  dateStart  DateTime
  dateEnd    DateTime
  nameSeason SeasonType   @default(BAJA)
  Bedrooms   Bedrooms[]
  Promotions Promotions[]
}

model bookingsServices {
  id         String    @id @default(uuid())
  bookingId  Int
  serviceId  Int
  price      Int
  servicesId String?
  services   Services? @relation(fields: [servicesId], references: [id])
}

model Invoce {
  id            Int             @id @default(autoincrement())
  clientId      Int
  date          DateTime
  invoceDetails invoceDetails[]
}

model invoceDetails {
  id       Int    @id @default(autoincrement())
  invoceId Int
  item     String
  price    Int
  amount   Int
  invoce   Invoce @relation(fields: [invoceId], references: [id])
}

model Bedrooms {
  id                 Int                  @id @default(autoincrement())
  description        String
  lowSeasonPrice     Int
  highSeasonPrice    Int
  status             Boolean
  numberBedroom      Int
  seasonsId          Int?
  amenities          String[]
  capacity           Int
  createdAt          DateTime             @default(now())
  image              String
  updatedAt          DateTime             @updatedAt
  slug               String               @unique
  typeBedroomId      Int?
  galleryImages      BedroomImages[]
  Seasons            Seasons?             @relation(fields: [seasonsId], references: [id])
  TypeBedrooms       TypeBedrooms?        @relation(fields: [typeBedroomId], references: [id])
  BedroomsPromotions BedroomsPromotions[]
  Comments           Comments[]
  ReservationDetails ReservationDetails[]
  testimonials       testimonials[]
}

model BedroomImages {
  id           Int      @id @default(autoincrement())
  bedroomId    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  fileName     String
  mimeType     String
  imageContent String?
  bedroom      Bedrooms @relation(fields: [bedroomId], references: [id])
}

model TypeBedrooms {
  id          Int        @id @default(autoincrement())
  nameType    String
  description String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  Bedrooms    Bedrooms[]
}

model Comments {
  id         Int       @id @default(autoincrement())
  comments   String
  bedroomsId Int?
  content    String
  createdAt  DateTime  @default(now())
  rating     Int       @default(0)
  updatedAt  DateTime
  userId     Int
  Bedrooms   Bedrooms? @relation(fields: [bedroomsId], references: [id])
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Events {
  id         Int      @id @default(autoincrement())
  nameEvents String
  date       DateTime
  hours      DateTime
  location   String
}

model UsersRole {
  Id_user Int @unique
  Id_role Int
}

model UserImage {
  id     Int    @id @default(autoincrement())
  userId Int    @unique
  image  String
  User   User   @relation(fields: [userId], references: [id])
}

model Promotions {
  id                 Int                  @id @default(autoincrement())
  codePromotions     String
  porcentageDescuent Int
  dateStart          DateTime
  dateEnd            DateTime
  description        String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  seasonId           Int
  BedroomsPromotions BedroomsPromotions[]
  seasons            Seasons              @relation(fields: [seasonId], references: [id])
  ReservationDetails ReservationDetails[]
}

model BedroomsPromotions {
  id          Int        @id @default(autoincrement())
  bedroomId   Int
  promotionId Int
  bedroom     Bedrooms   @relation(fields: [bedroomId], references: [id])
  promotion   Promotions @relation(fields: [promotionId], references: [id])

  @@unique([bedroomId, promotionId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model ReservationDetails {
  id             Int         @id @default(autoincrement())
  reservation_id Int
  price          Int
  dateStart      DateTime
  dateEnd        DateTime
  promotion_id   Int?
  status         Status
  created_at     DateTime    @default(now())
  bedrooms_id    Int
  guestQuantity  Int
  Bedrooms       Bedrooms    @relation(fields: [bedrooms_id], references: [id])
  Promotions     Promotions? @relation(fields: [promotion_id], references: [id])
  Reservation    Reservation @relation(fields: [reservation_id], references: [id])
}

enum NotificationType {
  CREATED
  CONFIRMED
  CANCELLED
}

enum BookingsStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum EventStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum Status {
  PENDING
  CONFIRMED
  CANCELLED
}

enum SeasonType {
  ALTA
  BAJA
}
